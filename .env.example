# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Development database. Production must inject an external managed PostgreSQL
# URL and set DATABASE_SSL_REQUIRE according to the database provider contract.
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/django_db
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False

# Browser security / cross-origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Platform Runtime adapters. ImmediateBackend is for development/test only.
TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend
TASKS_WEBHOOK_BACKEND=
PERIODIC_SCHEDULER_ENABLED=False
REALTIME_ENABLED=False
CHANNEL_LAYER_BACKEND=channels.layers.InMemoryChannelLayer
CHANNEL_LAYER_REDIS_URL=

# Logging
LOG_LEVEL=INFO

# API Keys (optional)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Docker build extras. Leave empty for dashboard-only deployments or use "api"
# when external REST integration is required.
UV_EXTRAS=
